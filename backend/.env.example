# Скопіюйте цей файл у .env та заповніть своїми даними

# Рядок підключення до Neon (беремо в дашборді Neon -> Connection string)
# Приклад: postgresql://user:password@ep-xxxx-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require

# Порт, на якому запускається сервер
PORT=3000

# Секретний токен для доступу до адмін-роутів (додавання/зміна/видалення товарів)
# Придумайте свій довгий випадковий рядок, нікому його не показуйте
ADMIN_TOKEN=changeme_super_secret_token

# Домен сайту (для правильних посилань у sitemap.xml та SEO-тегах)
SITE_URL=https://murattehnika.com.ua

# Ключ API Нової пошти — безкоштовно отримується в особистому кабінеті на new.poshta.ua
# (Налаштування -> Робота з API -> Отримати ключ), потрібен для вибору міста/відділення на сайті
NOVA_POSHTA_API_KEY=your_novaposhta_api_key

# Telegram-бот для сповіщень про нові замовлення
# 1. Створіть бота через @BotFather в Telegram -> отримаєте TELEGRAM_BOT_TOKEN
# 2. Напишіть боту "/start" (або додайте його в чат), потім дізнайтесь свій chat_id
#    через бота @userinfobot (він покаже ваш Telegram user ID) -> TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Дозволений домен фронтенду для CORS (можна залишити * на час розробки)
CORS_ORIGIN=*
